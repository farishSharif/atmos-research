# ---------------------------------------------------------------------------
# WorkSense environment variables
# Copy this file to `.env.local` and fill in your values.
# The app runs fully WITHOUT these (demo/localStorage mode); set them to use a
# real Supabase database.
# ---------------------------------------------------------------------------

# Supabase project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Settings -> API -> Project API keys -> anon public)
# Used by the browser to INSERT survey responses (RLS allows insert only).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Settings -> API -> Project API keys -> service_role)
# SERVER ONLY. Never expose this to the browser. Used by /api/responses to READ.
SUPABASE_SERVICE_ROLE_KEY=

# Admin password for the /dashboard page.
# If left blank, the demo default is "admin123".
ADMIN_PASSWORD=admin123
